# Copy to .env.local and fill in. .env.local is gitignored.

# REQUIRED. Privy app ID from https://dashboard.privy.io (App settings → App ID).
VITE_PRIVY_APP_ID=

# Optional. Alchemy key for arc-testnet + arc-mainnet endpoints.
# Unset falls back to the public Arc RPCs.
VITE_ALCHEMY_API_KEY=

# Optional. Defaults to ScratchAndSplit v3 (0xB049c84b48C0F57eD2FCa32131E16036eaDcE6A7).
VITE_SCRATCH_CONTRACT=0xB049c84b48C0F57eD2FCa32131E16036eaDcE6A7

# ── Server-side only (Vercel env, never VITE_-prefixed) ──────────────────────
# Passkey claims: 0x private key that pays Arc gas and receives the claimed gift.
EVM_HOT_WALLET_SECRET=
# Passkey claims: S... secret of the pre-funded Stellar USDC hot wallet.
# Generate with `bun scripts/setup-stellar-wallet.ts`.
STELLAR_HOT_WALLET_SECRET=
# Optional Stellar overrides (defaults: soroban-testnet / horizon-testnet / Circle testnet issuer).
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Passkey wallet deployment relayer (OpenZeppelin channels).
OZ_RELAYER_API_KEY=
